rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER FUNCTIONS
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dejavumallmw@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // VALIDATORS
    function isValidTreatment(data) {
      return data.id is number &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.price is number && data.price >= 0 &&
        data.duration is number && data.duration > 0 &&
        data.category is string && data.category.size() <= 120 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000)) &&
        (!('image' in data) || (data.image is string && data.image.size() <= 1000000));
    }

    function isValidTherapist(data) {
      return data.id is number &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.role is string && data.role.size() <= 100 &&
        data.bio is string && data.bio.size() <= 1500;
    }

    function isValidArticle(data) {
      return data.id is number &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.category is string && data.category.size() <= 50 &&
        data.content is string && data.content.size() <= 10000 &&
        data.author is string && data.author.size() <= 100;
    }

    function isValidGalleryItem(data) {
      return data.id is number &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.category is string && data.category.size() <= 60 &&
        data.image is string && data.image.size() <= 1000000;
    }

    function isValidCategory(data) {
      return data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
        data.label is string && data.label.size() > 0 && data.label.size() <= 100;
    }

    function isValidTestimonial(data) {
      return data.id is number &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.stars is number && data.stars >= 1 && data.stars <= 5 &&
        data.content is string && data.content.size() <= 3000 &&
        data.treatment is string && data.treatment.size() <= 150 &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000000));
    }

    function isValidBooking(data) {
      return data.id is number &&
        data.bookingId is string && data.bookingId.size() <= 50 &&
        data.clientName is string && data.clientName.size() <= 100 &&
        data.treatmentName is string && data.treatmentName.size() <= 150 &&
        data.date is string && data.date.size() <= 20 &&
        data.time is string && data.time.size() <= 10 &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        data.price is number && data.price >= 0;
    }

    function isValidSiteSettings(data) {
      return (!('brandName' in data) || (data.brandName is string && data.brandName.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 60)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000000)) &&
        (!('welcomePhotoUrl' in data) || (data.welcomePhotoUrl is string && data.welcomePhotoUrl.size() <= 1000000));
    }

    function isValidUser(data) {
      return data.id is number &&
        data.username is string && data.username.size() <= 100 &&
        data.firstName is string && data.firstName.size() <= 100 &&
        data.role in ['client', 'receptionist', 'admin'];
    }

    // ADMIN DIRECTORY
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isValidUser(incoming()) && incoming().role == 'client')
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role)
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // CATEGORIES CATALOG
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow create: if isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // TREATMENTS CATALOG
    match /treatments/{treatmentId} {
      allow read: if isValidId(treatmentId);
      allow create: if isValidId(treatmentId) && isValidTreatment(incoming());
      allow update: if isValidId(treatmentId) && isValidTreatment(incoming());
      allow delete: if isValidId(treatmentId);
    }

    // THERAPISTS CATALOG
    match /therapists/{therapistId} {
      allow read: if isValidId(therapistId);
      allow create: if isValidId(therapistId) && isValidTherapist(incoming());
      allow update: if isValidId(therapistId) && isValidTherapist(incoming());
      allow delete: if isValidId(therapistId);
    }

    // ARTICLES CATALOG
    match /articles/{articleId} {
      allow read: if isValidId(articleId);
      allow create: if isValidId(articleId) && isValidArticle(incoming());
      allow update: if isValidId(articleId) && isValidArticle(incoming());
      allow delete: if isValidId(articleId);
    }

    // GALLERY ATMOSPHERE
    match /gallery/{galleryId} {
      allow read: if isValidId(galleryId);
      allow create: if isValidId(galleryId) && isValidGalleryItem(incoming());
      allow update: if isValidId(galleryId) && isValidGalleryItem(incoming());
      allow delete: if isValidId(galleryId);
    }

    // TESTIMONIALS & REVIEWS
    match /testimonials/{testimonialId} {
      allow read: if isValidId(testimonialId);
      allow create: if isValidId(testimonialId) && isValidTestimonial(incoming());
      allow update: if isValidId(testimonialId) && isValidTestimonial(incoming());
      allow delete: if isValidId(testimonialId);
    }

    // SITE SETTINGS
    match /settings/{settingsId} {
      allow read: if isValidId(settingsId);
      allow create: if isValidId(settingsId) && isValidSiteSettings(incoming());
      allow update: if isValidId(settingsId) && isValidSiteSettings(incoming());
      allow delete: if isValidId(settingsId);
    }

    // BOOKINGS
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId);
      allow list: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId);
      allow delete: if isValidId(bookingId);
    }

    // CONNECTION TEST DOCUMENT
    match /test/{docId} {
      allow read: if true;
    }
  }
}
